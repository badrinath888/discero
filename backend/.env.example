# For production, use a PostgreSQL URL, e.g.:
#   DATABASE_URL=postgresql://user:password@host:5432/dbname
# ("postgres://" is also accepted and normalized automatically.)
# After deploying, run migrations with: alembic upgrade head
APP_NAME=Discero API
DATABASE_URL=sqlite:///./finance.db

# In production, set this to the deployed frontend origin(s) only
# (comma-separated). Do not use "*".
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

APP_ENV=development
FRONTEND_URL=http://localhost:3000
EMAIL_BACKEND=console
EMAIL_FROM=Discero <no-reply@example.com>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
PASSWORD_RESET_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_EXPIRE_HOURS=24

TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key

# Shared rate-limit store. Required for a horizontally-scaled (multiple
# instance) production deployment -- otherwise each instance keeps its
# own separate counters. Leave unset for local dev/single-instance use;
# CI never needs this set.
REDIS_URL=

ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# Copilot model provider: groq | anthropic | free. "free" needs no key
# and uses only the deterministic Copilot pipeline -- the safest local
# default. groq/anthropic fall back to free mode automatically if the
# matching key below is missing.
COPILOT_PROVIDER=free
GROQ_API_KEY=
COPILOT_GROQ_MODEL=llama-3.3-70b-versatile

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
PLAID_REDIRECT_URI=
