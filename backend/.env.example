# Local dev (default): file-based SQLite, zero setup
DATABASE_URL=sqlite:///./finance.db

# Production (Phase 4+ needs Postgres + pgvector):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/finance

# Optional (Phase 2): enables LLM categorization. Without it, the app uses
# deterministic rule-based categorization automatically.
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-6
